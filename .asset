supplier = "Schuberg Philis"
owner = "VPF Data&AI"
contact = "jjverhoeks@schubergphilis.com"

[[asset]]
name = "sqlengine"
path = "."
criticality = "high"
data_classification = "internal"
# Shipped container: simple multi-stage root Dockerfile (rust bookworm builder
# -> Chainguard glibc-dynamic runtime, final stage `runtime`, UID 65532).
# Same file for local compose, data-platform quickstart/sqe, and aikido-build
# (kaniko --target=runtime). Container CVEs gated by aikido-image-vuln
# (grype --fail-on high) on merge. Chainguard over distroless: grype finds
# unfixed debian libc criticals on distroless/cc; Chainguard stays clean.

[config]
image_scan = true
sast = true
hardening = true
secret_scan = true
sbom_verify = true
# High findings block by default; the platform default is "critical". On
# 2026-09-25 main had no grype, trivy or SAST finding at high, so this gate
# starts green.
fail_on = "high"
# Dependency reputation (deps.dev + OpenSSF Scorecard). Advisory; the closest
# the platform has to a malicious-package signal.
reputation = true

# Repo-owned license waivers live in .asset.license (read by
# sbom_license_check.py, which stamps this project on before matching, so they
# can never waive anything for another repo).

[[registry]]
type = "harbor"
repo = "repo.sovereign-data.org/chameleon"
username_var = "REGISTRY_USERNAME"
password_var = "REGISTRY_PASSWORD"

# ctutils 0.4.5 (RUSTSEC-2026-0385 fix) was published on 2026-10-23, before
# deps.dev indexed it, so aikido-reputation reports it as unresolved. It is the
# RustCrypto crate (github.com/RustCrypto/utils, Apache-2.0 OR MIT), not a
# slopsquat. Short expiry: once deps.dev has the version the waiver matches
# nothing and should be removed.
[[finding_suppression]]
rule = "reputation-unresolved"
path = "cargo/ctutils"
owner = "VPF Data&AI"
reason = "RustCrypto ctutils 0.4.5, published 2026-10-23 for RUSTSEC-2026-0385; deps.dev indexing lag, not an unknown package"
expires = "2026-11-06"
