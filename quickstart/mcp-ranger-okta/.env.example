# Copy to .env. Fill in the Okta values; everything else works as-is.

# Okta custom authorization server (Security > API > Authorization Servers).
# Issuer URI looks like https://dev-123456.okta.com/oauth2/aus1abcdef
# It must define scopes sqe:mcp:read and sqe:mcp:write and a `groups` claim
# on the access token (Okta group names = Ranger roles: analyst, engineer, sqe_admin).
OKTA_ISSUER=https://CHANGE-ME.okta.com/oauth2/CHANGE-ME
# `aud` of the access token; set the authorization server's Audience to this value.
OKTA_AUDIENCE=http://localhost:19092/mcp

# Source databases. Defaults point at the stack's own Polaris + RustFS.
SALES_WH_POLARIS_URL=http://polaris:8181/api/catalog
SALES_WH_WAREHOUSE=sales_wh
OPS_WH_POLARIS_URL=http://polaris:8181/api/catalog
OPS_WH_WAREHOUSE=ops_wh
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3adminpw
RANGER_URL=http://ranger-admin:6080

MCP_ALLOW_WRITES=false

# Reused polaris-ranger-keycloak stack (secrets and ports, kept clear of other quickstarts)
KEYCLOAK_ADMIN_PASSWORD=admin
SQE_CLIENT_SECRET=sqe-secret-change-me
POLARIS_BOOTSTRAP_SECRET=polaris-root-secret
RANGER_ADMIN_PASSWORD=rangerR0cks!
POSTGRES_PASSWORD=rangerR0cks!
KEYCLOAK_PORT=38080
POLARIS_PORT=28181
RANGER_PORT=26080
RUSTFS_PORT=29000
RUSTFS_CONSOLE_PORT=29001
SQE_FLIGHT_PORT=60061
SQE_TRINO_PORT=28080
SQE_MCP_PORT=19092

SQE_IMAGE=sqe-quickstart:latest
SQE_CARGO_PROFILE=dev-release
