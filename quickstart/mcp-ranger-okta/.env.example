# Copy to .env. Fill in the Okta values and the external data; the rest works as-is.
# No secrets or tokens belong in this file.

# ── Okta: custom authorization server + native app `sqemcp` (see okta/ and README) ──
# Issuer of the CUSTOM authorization server (…/oauth2/<server id>), not the org URL.
OKTA_ISSUER=https://CHANGE-ME.okta.com/oauth2/CHANGE-ME
# Client ID of the native app. Public client: there is no secret.
OKTA_CLIENT_ID=CHANGE-ME
# Must equal the authorization server audience and SQE's mcp.resource_uri.
OKTA_AUDIENCE=http://localhost:19092/mcp
# Okta groups; also the Ranger groups the bootstrap policies target.
READONLY_GROUP=datalake_readonly
SENSITIVE_GROUP=datalake_sensitive_ro

# ── External data: AWS Glue Data Catalog + S3 ──
# AWS credentials are NOT set here: export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN in the shell before ./run.sh (Fargate: task role). See README.
AWS_REGION=eu-central-1
# SQL name of the Glue catalog: tables resolve as <GLUE_CATALOG>.<database>.<table>.
GLUE_CATALOG=glue
# Comma-separated Glue databases to expose (lower-case). Empty = every database.
GLUE_DATABASES=
# Tables only SENSITIVE_GROUP may read, as <catalog>.<database>.<table>, comma separated.
SENSITIVE_TABLES=

MCP_ALLOW_WRITES=false

# ── Stack ──
RANGER_ADMIN_PASSWORD=rangerR0cks!
POSTGRES_PASSWORD=rangerR0cks!
RANGER_PORT=26080
SQE_MCP_PORT=19092
SQE_IMAGE=sqe-quickstart:latest
SQE_CARGO_PROFILE=dev-release
