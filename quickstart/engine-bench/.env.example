# Copy to .env (run.sh does it on first run). Defaults work as-is.

# --- Workload: set inline (SIZE=50 ./run.sh); a value here wins over inline ---
# SIZE=10               # millions of sales rows: 10, 50, 150
# REPS=3
# MEM=3g                # memory setting every engine gets
# ENGINES=sqe-parquet,sqe-iceberg,sqe-polaris,duckdb,polars
# WITH_SPARK=1

# --- SQE binaries (default: target/release/ of this repo, built on demand) ---
# SQE_CLI=/path/to/sqe-cli
# SQE_SERVER=/path/to/sqe-server

# --- Polaris + RustFS (local-only demo secrets) ---
POLARIS_ROOT_SECRET=polaris-root-secret
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3adminpw

# --- Host ports (offset so this stack runs next to the other local stacks) ---
POLARIS_PORT=38181
RUSTFS_PORT=39000
SQE_FLIGHT_PORT=61051
SQE_TRINO_PORT=38080
SQE_METRICS_PORT=39090  # /healthz is on this port + 1
