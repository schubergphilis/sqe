# Local-only quickstart ports. SQE MCP shares the existing web/health listener.
KEYCLOAK_PORT=28080
POLARIS_PORT=18181
RUSTFS_PORT=19000
RUSTFS_CONSOLE_PORT=19001
SQE_FLIGHT_PORT=60051
SQE_TRINO_PORT=18080
SQE_MCP_PORT=19091

# Start read-only. `./run.sh --writes` overrides this for the write-gate demo.
MCP_ALLOW_WRITES=false

# Reused stack credentials. These are deliberately local demo values.
KEYCLOAK_ADMIN_PASSWORD=admin
SQE_CLIENT_SECRET=sqe-secret-change-me
ROOT_PASSWORD=root123
POLARIS_BOOTSTRAP_SECRET=polaris-root-secret
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3adminpw

SQE_IMAGE=sqe-quickstart:latest
