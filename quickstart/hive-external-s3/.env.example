# Copy to .env to override. Defaults match docker-compose.yml.
#
# Host port for the S3-compatible store. Offset from the integration stack's
# 19000 so both can run at once.
S3_PORT=19100
# Store credentials. Placeholders, not secrets: this store is local and
# ephemeral. A real deployment puts the key in the environment
# (SQE_STORAGE__S3_SECRET_KEY) or a named SECRET, never on the command line.
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin
S3_REGION=us-east-1
# Approximate total size of the generated data, across all four tables.
# 5120 is the generator's ceiling.
SIZE_MB=64
